{
  "expo": {
    "name": "Drinking Democracy",
    "slug": "drinkingdemocracy",
    "version": "1.5.0",
    "icon": "./assets/images/logo.png",
    "scheme": "drinkingdemocracy",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielportelabyrne.drinkingdemocracy",
      "buildNumber": "2"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#131313"
      },
      "versionCode": 10,
      "package": "com.danielportelabyrne.drinkingdemocracy"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "06a6ae2b-445d-422b-955b-ab769aaacac4"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#131313"
        }
      ]
    ]
  }
}
